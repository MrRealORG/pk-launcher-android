<?xml version="1.0" encoding="utf-8"?>
<!-- PK Launcher home. Keeps MojoLauncher's ids (news_button, custom_control_button, ...)
     and the version spinner / play button at the bottom. -->
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/fragment_menu_main"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/background_app">
	<ScrollView
		android:id="@+id/pk_home_scroll"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:clipToPadding="false"
		android:fadingEdgeLength="@dimen/_12sdp"
		android:requiresFadingEdge="vertical"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintBottom_toTopOf="@id/mc_version_spinner">
		<LinearLayout
			android:id="@+id/pk_home_column"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingHorizontal="@dimen/_12sdp"
			android:paddingTop="@dimen/_10sdp"
			android:paddingBottom="@dimen/_12sdp">
			<FrameLayout
				android:id="@+id/pk_header"
				android:layout_width="match_parent"
				android:layout_height="@dimen/_96sdp"
				android:background="@drawable/pk_header_bg">
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingHorizontal="@dimen/_14sdp">
					<ImageView
						android:id="@+id/pk_header_mark"
						android:layout_width="@dimen/_48sdp"
						android:layout_height="@dimen/_48sdp"
						android:src="@drawable/pk_mark"
						android:contentDescription="@string/app_short_name" />
					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:layout_marginStart="@dimen/_10sdp"
						android:orientation="vertical">
						<TextView
							android:id="@+id/pk_header_title"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/app_short_name"
							android:textColor="@color/pk_text"
							android:textSize="@dimen/_16ssp"
							android:textStyle="bold" />
						<TextView
							android:id="@+id/pk_header_status"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/pk_home_greeting"
							android:textColor="@color/pk_muted"
							android:textSize="@dimen/_10ssp" />
					</LinearLayout>
				</LinearLayout>
			</FrameLayout>
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/_8sdp"
				android:orientation="horizontal">
				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/pk_servers_button"
					android:layout_width="0dp"
					android:layout_height="@dimen/_52sdp"
					android:layout_weight="1"
					android:layout_marginEnd="@dimen/_4sdp"
					android:background="@drawable/pk_tile_bg"
					android:stateListAnimator="@null"
					android:textAllCaps="false"
					android:maxLines="2"
					android:ellipsize="end"
					android:text="@string/pk_menu_servers"
					android:drawableStart="@drawable/ic_pk_server" />
				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/pk_mods_button"
					android:layout_width="0dp"
					android:layout_height="@dimen/_52sdp"
					android:layout_weight="1"
					android:layout_marginStart="@dimen/_4sdp"
					android:background="@drawable/pk_tile_bg"
					android:stateListAnimator="@null"
					android:textAllCaps="false"
					android:maxLines="2"
					android:ellipsize="end"
					android:text="@string/pk_menu_mods"
					android:drawableStart="@drawable/ic_px_file_dl" />
			</LinearLayout>
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/_8sdp"
				android:orientation="horizontal">
				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/news_button"
					android:layout_width="0dp"
					android:layout_height="@dimen/_52sdp"
					android:layout_weight="1"
					android:layout_marginEnd="@dimen/_4sdp"
					android:background="@drawable/pk_tile_bg"
					android:stateListAnimator="@null"
					android:textAllCaps="false"
					android:maxLines="2"
					android:ellipsize="end"
					android:text="@string/pk_menu_news"
					android:drawableStart="@drawable/ic_px_bell" />
				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/pk_themes_button"
					android:layout_width="0dp"
					android:layout_height="@dimen/_52sdp"
					android:layout_weight="1"
					android:layout_marginStart="@dimen/_4sdp"
					android:background="@drawable/pk_tile_bg"
					android:stateListAnimator="@null"
					android:textAllCaps="false"
					android:maxLines="2"
					android:ellipsize="end"
					android:text="@string/pk_menu_themes"
					android:drawableStart="@drawable/ic_pk_brush" />
			</LinearLayout>
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/_8sdp"
				android:orientation="horizontal">
				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/custom_control_button"
					android:layout_width="0dp"
					android:layout_height="@dimen/_52sdp"
					android:layout_weight="1"
					android:layout_marginEnd="@dimen/_4sdp"
					android:background="@drawable/pk_tile_bg"
					android:stateListAnimator="@null"
					android:textAllCaps="false"
					android:maxLines="2"
					android:ellipsize="end"
					android:text="@string/mcl_option_customcontrol"
					android:drawableStart="@drawable/ic_px_gamepad" />
				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/install_jar_button"
					android:layout_width="0dp"
					android:layout_height="@dimen/_52sdp"
					android:layout_weight="1"
					android:layout_marginStart="@dimen/_4sdp"
					android:background="@drawable/pk_tile_bg"
					android:stateListAnimator="@null"
					android:textAllCaps="false"
					android:maxLines="2"
					android:ellipsize="end"
					android:text="@string/main_install_jar_file"
					android:drawableStart="@drawable/ic_px_java_run" />
			</LinearLayout>
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/_8sdp"
				android:orientation="horizontal">
				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/share_logs_button"
					android:layout_width="0dp"
					android:layout_height="@dimen/_52sdp"
					android:layout_weight="1"
					android:layout_marginEnd="@dimen/_4sdp"
					android:background="@drawable/pk_tile_bg"
					android:stateListAnimator="@null"
					android:textAllCaps="false"
					android:maxLines="2"
					android:ellipsize="end"
					android:text="@string/main_share_logs"
					android:drawableStart="@drawable/ic_px_sharelog" />
				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/open_files_button"
					android:layout_width="0dp"
					android:layout_height="@dimen/_52sdp"
					android:layout_weight="1"
					android:layout_marginStart="@dimen/_4sdp"
					android:background="@drawable/pk_tile_bg"
					android:stateListAnimator="@null"
					android:textAllCaps="false"
					android:maxLines="2"
					android:ellipsize="end"
					android:text="@string/mcl_button_open_directory"
					android:drawableStart="@drawable/ic_px_folder" />
			</LinearLayout>
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/_8sdp"
				android:orientation="horizontal">
				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/pk_horizon_button"
					android:layout_width="0dp"
					android:layout_height="@dimen/_52sdp"
					android:layout_weight="1"
					android:layout_marginEnd="@dimen/_4sdp"
					android:background="@drawable/pk_tile_bg"
					android:stateListAnimator="@null"
					android:textAllCaps="false"
					android:maxLines="2"
					android:ellipsize="end"
					android:text="@string/pk_menu_horizon"
					android:drawableStart="@drawable/ic_px_zap" />
				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/pk_bug_button"
					android:layout_width="0dp"
					android:layout_height="@dimen/_52sdp"
					android:layout_weight="1"
					android:layout_marginStart="@dimen/_4sdp"
					android:background="@drawable/pk_tile_bg"
					android:stateListAnimator="@null"
					android:textAllCaps="false"
					android:maxLines="2"
					android:ellipsize="end"
					android:text="@string/pk_menu_bug"
					android:drawableStart="@drawable/ic_pk_bug" />
			</LinearLayout>
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/_8sdp"
				android:orientation="horizontal">
				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/pk_about_button"
					android:layout_width="0dp"
					android:layout_height="@dimen/_52sdp"
					android:layout_weight="1"
					android:layout_marginEnd="@dimen/_4sdp"
					android:background="@drawable/pk_tile_bg"
					android:stateListAnimator="@null"
					android:textAllCaps="false"
					android:maxLines="2"
					android:ellipsize="end"
					android:text="@string/pk_menu_about"
					android:drawableStart="@drawable/ic_pk_info" />
				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/social_media_button"
					android:layout_width="0dp"
					android:layout_height="@dimen/_52sdp"
					android:layout_weight="1"
					android:layout_marginStart="@dimen/_4sdp"
					android:background="@drawable/pk_tile_bg"
					android:stateListAnimator="@null"
					android:textAllCaps="false"
					android:maxLines="2"
					android:ellipsize="end"
					android:text="@string/mcl_button_social_media"
					android:drawableStart="@drawable/ic_social_media" />
			</LinearLayout>
		</LinearLayout>
	</ScrollView>

	<com.kdt.mcgui.mcVersionSpinner
		android:id="@+id/mc_version_spinner"
		android:layout_width="0dp"
		android:layout_height="@dimen/_52sdp"
		android:background="@android:color/transparent"
		android:drawableEnd="@drawable/spinner_arrow"

		app:drawableEndSize="@dimen/padding_heavy"
		app:drawableStartIntegerScaling="true"
		app:drawableStartSize="@dimen/_36sdp"
		app:drawableEndPadding="@dimen/_1sdp"

		app:layout_constraintBottom_toTopOf="@id/play_button"
		app:layout_constraintEnd_toStartOf="@+id/edit_profile_button"
		app:layout_constraintStart_toStartOf="parent" />

	<ImageButton
		android:id="@+id/edit_profile_button"
		android:layout_width="@dimen/_52sdp"
		android:layout_height="@dimen/_52sdp"
		android:background="?android:attr/selectableItemBackground"

		android:src="@drawable/ic_px_edit"
		app:layout_constraintBottom_toBottomOf="@+id/mc_version_spinner"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintTop_toTopOf="@+id/mc_version_spinner" />

	<!-- This view is for cosmetic purpose only -->
	<View
		android:id="@+id/_background_display_view"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:background="@color/background_bottom_bar"
		android:translationZ="-1dp"

		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintTop_toTopOf="@id/mc_version_spinner" />

	<com.kdt.mcgui.MineButton
		android:id="@+id/play_button"
		android:layout_width="match_parent"
		android:layout_height="@dimen/_56sdp"

		android:layout_marginHorizontal="@dimen/_17sdp"
		android:layout_marginBottom="@dimen/_15sdp"
		android:textColor="@android:color/white"
		android:stateListAnimator="@null"

		android:textAllCaps="true"
		android:text="@string/main_play"
		app:layout_constraintBottom_toBottomOf="parent"
		/>

</androidx.constraintlayout.widget.ConstraintLayout>
